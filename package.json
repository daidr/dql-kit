{
  "name": "dql-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --workspaces build",
    "type-check": "bun run --workspaces type-check",
    "test": "bun run --workspaces --if-present test",
    "lint": "oxlint --deny-warnings packages"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "oxlint": "^1.88.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
