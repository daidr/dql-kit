{
  "name": "@dql-kit/typebox",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external @sinclair/typebox --external @dql-kit/core && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --conditions development"
  },
  "dependencies": {
    "@dql-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "@sinclair/typebox": ">=0.34.0 <0.35.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@types/bun": "^1.4.3",
    "ajv": "^8.17.1",
    "typescript": "^5.5.0"
  }
}
