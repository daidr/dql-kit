{
  "name": "@dql-kit/vue-router-sync",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm --external vue --external vue-router --external @dql-kit/core --external @dql-kit/vue-headless && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dql-kit/core": "workspace:*",
    "@dql-kit/vue-headless": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  }
}
