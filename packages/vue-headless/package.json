{
  "name": "@dql-kit/vue-headless",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm --external vue --external vue-router --external @dql-kit/core",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dql-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": { "optional": true }
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  }
}
