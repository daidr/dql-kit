{
  "name": "@dql-kit/vue-ui",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "development": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --format esm --external vue --external @dql-kit/core --external @dql-kit/vue-headless && tsc -p tsconfig.build.json && bun run ./scripts/copy-styles.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dql-kit/core": "workspace:*",
    "@dql-kit/vue-headless": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@dql-kit/drizzle-pg": "workspace:*",
    "@electric-sql/pglite": "^0.5.10",
    "@vue/test-utils": "^2.5.1",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
