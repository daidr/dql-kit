{
  "name": "@dql-kit/drizzle-sqlite",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external drizzle-orm --external @dql-kit/core && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@dql-kit/core": "workspace:*",
    "@dql-kit/drizzle-common": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "drizzle-orm": "^0.45.4",
    "typescript": "^7.0.2"
  }
}
