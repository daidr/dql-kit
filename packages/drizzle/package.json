{
  "name": "@dql-kit/drizzle",
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external drizzle-orm --external @dql-kit/core",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dql-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-orm": "^0.45.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
